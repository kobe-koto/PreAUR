# Home directory of the preaur user; the project directory lives at
# /var/lib/preaur/preaur and the default metadata chroot at /var/lib/preaur/metadata.
d /var/lib/preaur 0750 preaur preaur -
# Parent of the default metadata chroots. mkarchroot cannot create a root whose
# parent directory is missing; the roots themselves are created by root.
d /var/lib/preaur/metadata 0755 preaur preaur -
