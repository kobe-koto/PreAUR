# yaml-language-server: $schema=https://raw.githubusercontent.com/kobe-koto/PreAUR/main/preaur.schema.json

config:
  # PKGBUILD version parser backend:
  # "native" -> fast built-in parser with bash expansion fallback (default)
  # "makepkg" -> use `makepkg --printsrcinfo` for makepkg-compatible parsing
  pkgbuildParser: "native"
  # PKGBUILD metadata commands run in a chroot sandbox by default. This covers
  # makepkg --printsrcinfo, dynamic pkgver(), and updpkgsums before the package
  # enters the real build.
  pkgbuildSandbox:
    enabled: true
    # Dedicated metadata chroot managed by PreAUR (never a devtools build
    # chroot). Defaults to /var/lib/preaur/metadata/<repo>-<arch> derived from
    # builder. It is updated once per run before the first metadata command.
    # root: "/var/lib/preaur/metadata/extra-x86_64"
    command: "systemd-nspawn"
    sudo: true
    user: "preaur"
    network: true
    # Use systemd-nspawn --volatile=overlay so metadata commands run on a
    # read-only root with a tmpfs overlay that is discarded after each command.
    ephemeral: true
    # If the root does not exist, create it with devtools mkarchroot.
    initRoot: true
    # Extra tools needed by metadata commands, installed once into the root.
    # base-devel, git, and pacman-contrib are always installed.
    # packages:
    #   - nodejs
  # Compiler/linker overrides for devtools chroot builds, applied through a
  # generated /etc/makepkg.conf.d drop-in. Unset fields keep makepkg defaults.
  # Packages can override any field with their own `toolchain:` block.
  # toolchain:
  #   llvm: true          # clang/clang++, llvm-ar/ranlib/nm, llvm-strip; LLD by default
  #   mold: "driver"      # true/driver: -fuse-ld=mold; replace: /usr/bin/ld -> ld.mold
  #   lld: false          # same modes as mold; false drops llvm's implicit LLD
  #   lto: "thin"         # default | off | thin (needs llvm) | full
  #   debug: false        # false -> !debug, true -> debug
  #   stripOnLink: false  # -s in LDFLAGS plus !strip
  # Extra git URL prefixes that should still be treated as trusted AUR mirrors
  # for ownership checks. Built-ins:
  # - ssh://aur@aur.archlinux.org/
  # - https://aur.archlinux.org/
  # trustedAurGitPrefixes:
  #   - "https://aur-mirror.example.org/"

# Packager identities. Builds by a package's maintainer run with
# PACKAGER="PreAUR (on behalf of <name>) <<email>>".
maintainers:
  - id: "johndoe"
    name: "John Doe"
    email: "john.doe@example.com"

default_maintainer: "johndoe"

# Project git automation (on by default). If the working directory is a git
# repository with this remote, PreAUR pulls before each run and commits/pushes
# changes in data/ afterwards. Skipped with a warning otherwise.
# git:
#   enabled: true
#   remote: "origin"
#   branch: "main" # default: current branch
#   sync:
#     allow_remote_overwrite_local: false # true -> git reset --hard to the remote instead of pull --ff-only
#   push:
#     force: false

# Webhook notifications for build progress reporting
# webhooks:
#   # Discord webhook example - using direct template in payload
#   - id: "discord"
#     url: "https://discord.com/api/webhooks/123456/abcdef"
#     method: "POST"
#     payload:
#       content: "✅ Built {{pkgname}} {{version}} in {{buildTime}}s"
#     tags:
#       - BUILD_SUCCESSFUL
#       - BUILD_FAILED
#
#   # Advanced: use {{_rendered}} to reference the rendered template message
#   - id: "discord-advanced"
#     url: "https://discord.com/api/webhooks/123456/abcdef"
#     payload:
#       embeds:
#         - title: "PreAUR Build"
#           description: "{{_rendered}}"
#           color: 5763719
#     tags:
#       - BUILD_SUCCESSFUL
#     templates:
#       BUILD_SUCCESSFUL: "✅ Built {{pkgname}} {{version}} in {{buildTime}}s"
#
#   # Telegram webhook example
#   - id: "telegram"
#     url: "https://api.telegram.org/bot<YOUR_BOT_TOKEN>/sendMessage"
#     method: "POST"
#     payload:
#       chat_id: "-1001234567890"
#       text: "{{_rendered}}"
#       parse_mode: "Markdown"
#     tags:
#       - APPROVAL_UNAPPROVED
#       - PACKAGE_UPDATED
#     templates:
#       PACKAGE_UPDATED: "📦 *{{pkgname}}* updated to `{{version}}`"
#
#   # Simple HTTP endpoint (uses default payload: {message: <rendered_template>})
#   - id: "simple"
#     url: "https://example.com/webhook"
#     tags:
#       - BUILD_FAILED
#
# Available event tags:
#   - SESSION_START, SESSION_END, SESSION_FAILED
#   - APPROVAL_NEW_PACKAGE, APPROVAL_NEW_MAINTAINER, APPROVAL_UNAPPROVED, APPROVAL_PASSED
#   - PACKAGE_UPDATED, PACKAGE_NO_UPDATE, PACKAGE_CHECK_FAILED
#   - BUILD_START, BUILD_SUCCESSFUL, BUILD_FAILED
#   - PUSH_START, PUSH_SUCCESSFUL, PUSH_FAILED
#
# Template variables:
#   {{pkgname}}, {{version}}, {{pkgver}}, {{pkgrel}}, {{epoch}},
#   {{maintainer}}, {{reason}}, {{error}}, {{buildTime}}, {{timestamp}} (ISO 8601 time)
#   {{_rendered}} - the rendered template message (use in payload to reference templates)
#
# Notes:
#   - If 'payload' is omitted, defaults to: {message: <rendered_template>}
#   - Template variables work in: url, payload fields, and custom templates
#   - {{_rendered}} is special: it contains the already-rendered template for that event
#   - If 'templates' omits an event, the built-in default template is used

resources:
  # Controls $MAKEFLAGS internally
  # "-2" -> uses (total_cores - 2)
  # "-1" -> uses (total_cores - 1) - default logic if omitted
  # "--all" -> uses all logical cores
  # "4" -> explicitly use 4 cores
  cpu: "-2"
  parallel: 2
  updateCheckCocurrent: 5 # at least / by default 1, this may cause rate-limiting issues if set too high

# Optional, but without it built packages are not collected and already-built
# versions are not skipped. Built packages and myrepo.db.tar.gz go to repo/myrepo/.
repo:
  name: "myrepo"

packages:
  # packages[].maintainer is optional. If omitted, default_maintainer is used.
  #
  # If an AUR package is orphaned, PreAUR skips its build unless this is set
  # on that package:
  # allow_orphan_package_build: true
  #
  # If `git` points at a trusted AUR prefix, PreAUR derives the AUR name from
  # the URL. Use aur_pkgname when the AUR name needs to be explicit:
  # aur_pkgname: "upstream-aur-name"

  # Standard Github release mapped package
  - pkgname: "grub-theme-lain"
    maintainer: "johndoe"
    checker:
      type: "github" # Version query provider
      repo: "uiriansan/LainGrubTheme"
      use: "release" # Set to 'prerelease' if using beta tags
      # prefix/suffix also filter: releases whose tag lacks them are skipped, so
      # monorepos can pick e.g. the newest "app-release-*" tag. Matching text is stripped.
      # prefix: "app-release-" # remove prefix if not needed
      # suffix: "_beta" # remove suffix if not needed
      normalize: true # replace colons :, forward slashes /, hyphens -, or whitespaces with underscores
    push: true # Automatically git commit and push back to AUR on success
    builder: "extra-x86_64-build" # Specific build executable. Can use "pkgctl build" if preferred! Defaults to extra-x86_64-build
    dummy_packages:
      - dummy: "grub" # builds a `grub-dummy` package that provides "grub"
        epoch: 2
        pkgver: 2.14
        pkgrel: 1
        files:
          - /usr/bin/grub # created as an empty file

  # Git/Dynamic Versioning mapped package
  - pkgname: "grub-theme-lobo-git"
    maintainer: "johndoe"
    # Notice: No checker is needed here.
    # preaur automatically detects the `pkgver()` bash block
    # and invokes `makepkg -odc` to pull the latest commits and dynamically set the package version.
    dummy_packages:
      - dummy: "grub" # builds a `grub-dummy` package that provides "grub"
        epoch: 2
        pkgver: 2.14
        pkgrel: 1
        files:
          - /usr/bin/grub # created as an empty file
    repo_packages: # packages built into this repo that are installed before building this one
      - grub-theme-lain
    # Per-package toolchain overrides replace config.toolchain field by field.
    # toolchain:
    #   lto: "off"

  # Debian/APT repository mapped package
  - pkgname: "visual-studio-code-bin"
    maintainer: "johndoe"
    checker:
      type: "deb"
      strip_version: true # keep only the part before the first "-" or "_" (drops the Debian/RPM release)
      url: "https://packages.microsoft.com/repos/vscode"
      dist: "stable"
      component: "main"
      arch: "amd64"
      pkg: "code"

  # RPM/Yum repository mapped package example
  - pkgname: "visual-studio-code-electron-bin"
    maintainer: "johndoe"
    checker:
      type: "rpm"
      strip_version: true # keep only the part before the first "-" or "_" (drops the Debian/RPM release)
      url: "https://packages.microsoft.com/yumrepos/vscode"
      pkg: "code"

  # JSON HTTP API mapped package
  - pkgname: "clion"
    maintainer: "johndoe"
    checker:
      type: "json"
      url: "https://data.services.jetbrains.com/products"
      params:
        code: "CL"
        release.type: "release"
        # Cache buster. In params, {{timestamp}} is milliseconds since the epoch
        # (unlike the ISO time in webhook templates); {{random=N}} gives N random
        # [A-Za-z0-9] characters. Both are regenerated on every request.
        _: "{{timestamp}}"
      # JSONPath (jsonpath-plus); filters such as [?(@.type=="release")] are supported
      path: "$[0].releases[*].version"
      sort_by: "version" # newest by version comparison (default); "none" takes the first match

  # Template example: maps a version such as 1.2.3.4.abcdef to pkgver=1.2.3.4 and _commit=abcdef
  - pkgname: "spotify"
    maintainer: "johndoe"
    checker:
      type: "deb"
      # template also filters: versions it cannot parse are ignored when picking the latest
      template: "{~pkgver}.{~pkgver}.{~pkgver}.{~pkgver}.{_commit}"
      url: "https://repository.spotify.com"
      dist: "testing"
      component: "non-free"
      arch: "amd64"
      pkg: "spotify-client"
