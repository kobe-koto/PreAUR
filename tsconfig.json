{
    "compilerOptions": {
        // src/ must stay Node-compatible: only Node types here. Tests get Bun
        // types from test/tsconfig.json.
        "types": [
            "node"
        ],
        // Environment setup & latest features
        "lib": [
            "ESNext"
        ],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "allowJs": true,
        // Bundler mode
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        // Only syntax that type stripping can remove, so Node can run src/ directly.
        "erasableSyntaxOnly": true,
        "noEmit": true,
        // Best practices
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        // Some stricter flags (disabled by default)
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false
    },
    "include": [
        "src/**/*.ts",
        "build.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "pkgbuilds",
        "work",
        "repo",
        "logs",
        "tmp"
    ]
}
