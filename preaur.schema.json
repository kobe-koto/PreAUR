{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "maintainers": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Stable maintainer id used by packages."
                    },
                    "name": {
                        "type": "string",
                        "description": "Maintainer display name."
                    },
                    "email": {
                        "type": "string",
                        "description": "Maintainer email address."
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "additionalProperties": false,
                "description": "A packager identity."
            },
            "description": "Known PreAUR maintainers."
        },
        "default_maintainer": {
            "description": "Maintainer id used when a package omits maintainer.",
            "type": "string"
        },
        "git": {
            "description": "Project repository automation.",
            "default": {},
            "type": "object",
            "properties": {
                "enabled": {
                    "default": true,
                    "description": "Enable project git automation.",
                    "type": "boolean"
                },
                "remote": {
                    "default": "origin",
                    "description": "Remote used for sync and push.",
                    "type": "string"
                },
                "branch": {
                    "description": "Branch used for sync and push. Default: current branch.",
                    "type": "string"
                },
                "sync": {
                    "description": "Project git startup sync policy.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "allow_remote_overwrite_local": {
                            "default": false,
                            "description": "Reset local state to remote during sync.",
                            "type": "boolean"
                        },
                        "allowRemoteOverwriteLocal": {
                            "description": "CamelCase alias for allow_remote_overwrite_local.",
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                },
                "push": {
                    "description": "Project git push policy.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "force": {
                            "default": false,
                            "description": "Use git push --force after builds.",
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "config": {
            "type": "object",
            "properties": {
                "pkgbuildParser": {
                    "description": "PKGBUILD parser implementation.",
                    "type": "string",
                    "enum": [
                        "native",
                        "makepkg"
                    ]
                },
                "checksumArch": {
                    "description": "Default checksum scope for all packages: all or target. Default: all. See the package checksumArch option.",
                    "type": "string",
                    "enum": [
                        "all",
                        "target"
                    ]
                },
                "trustedAurGitPrefixes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Git URL prefixes treated as AUR package sources."
                },
                "pkgbuildSandbox": {
                    "description": "Chroot sandbox used for PKGBUILD metadata commands before building.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "default": true,
                            "description": "Run PKGBUILD metadata commands inside a chroot sandbox.",
                            "type": "boolean"
                        },
                        "root": {
                            "description": "Dedicated metadata chroot root managed by PreAUR. Defaults to /var/lib/preaur/metadata/<repo>-<arch> derived from the package builder. Must not be a devtools build chroot.",
                            "type": "string"
                        },
                        "command": {
                            "default": "systemd-nspawn",
                            "description": "Sandbox command used to enter the chroot.",
                            "type": "string"
                        },
                        "sudo": {
                            "default": true,
                            "description": "Run the sandbox command through sudo when PreAUR is not root.",
                            "type": "boolean"
                        },
                        "user": {
                            "default": "preaur",
                            "description": "User used inside the chroot for makepkg commands. It is created with the host UID when missing.",
                            "type": "string"
                        },
                        "network": {
                            "default": true,
                            "description": "Allow network access inside the PKGBUILD sandbox.",
                            "type": "boolean"
                        },
                        "ephemeral": {
                            "default": true,
                            "description": "Run metadata commands on a read-only view of the root with a tmpfs overlay (systemd-nspawn --volatile=overlay); changes are discarded after the command exits.",
                            "type": "boolean"
                        },
                        "initRoot": {
                            "default": true,
                            "description": "Create a missing metadata chroot root with devtools mkarchroot.",
                            "type": "boolean"
                        },
                        "packages": {
                            "default": [],
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Extra packages installed once into the persistent metadata chroot root, in addition to base-devel, git, and pacman-contrib."
                        }
                    },
                    "additionalProperties": false
                },
                "chrootPacman": {
                    "type": "object",
                    "properties": {
                        "include": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Host files included into generated pacman.conf."
                        },
                        "lines": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Raw pacman.conf lines appended globally."
                        },
                        "repositories": {
                            "description": "Custom chroot pacman repositories.",
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Pacman repository name."
                                    },
                                    "siglevel": {
                                        "description": "Repository SigLevel line.",
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        ]
                                    },
                                    "include": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Host files included into this repository block."
                                    },
                                    "lines": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Raw pacman.conf lines appended to this repository block."
                                    }
                                },
                                "required": [
                                    "name"
                                ],
                                "additionalProperties": false,
                                "description": "A custom pacman repository for chroot builds."
                            }
                        }
                    },
                    "additionalProperties": false,
                    "description": "Pacman configuration added to devtools chroots."
                },
                "toolchain": {
                    "description": "Global toolchain options for all packages. Packages can override individual fields with their own toolchain block.",
                    "type": "object",
                    "properties": {
                        "llvm": {
                            "description": "Build with Clang/LLVM: CC=clang, CXX=clang++, llvm-ar/llvm-ranlib/llvm-nm, and llvm-strip. Links with LLD in driver mode unless lld is false or mold is enabled. Installs clang and llvm in the chroot.",
                            "type": "boolean"
                        },
                        "mold": {
                            "description": "Link with mold. driver (or true): -fuse-ld=mold in LDFLAGS and RUSTFLAGS. replace: point /usr/bin/ld at ld.mold in the build chroot so every link uses mold. Installs mold in the chroot.",
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "driver",
                                        "replace"
                                    ]
                                }
                            ]
                        },
                        "lld": {
                            "description": "Link with LLD. driver (or true): -fuse-ld=lld in LDFLAGS and RUSTFLAGS. replace: point /usr/bin/ld at ld.lld in the build chroot. false disables the implicit LLD of llvm. With GCC it requires lto: off. Installs lld in the chroot.",
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "driver",
                                        "replace"
                                    ]
                                }
                            ]
                        },
                        "lto": {
                            "description": "C/C++ link-time optimization: default keeps the makepkg policy, off disables LTO, thin uses LLVM ThinLTO (requires llvm), full uses -flto=full (LLVM) or -flto=auto with gcc-ar/gcc-ranlib/gcc-nm (GCC).",
                            "type": "string",
                            "enum": [
                                "default",
                                "off",
                                "thin",
                                "full"
                            ]
                        },
                        "debug": {
                            "description": "Force makepkg debug packages on (true) or off (false). Unset keeps the chroot makepkg.conf policy.",
                            "type": "boolean"
                        },
                        "stripOnLink": {
                            "description": "Strip at link time (-s in LDFLAGS) and disable makepkg post-build stripping (!strip). No debug package is produced.",
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false,
            "description": "Runtime behavior settings."
        },
        "resources": {
            "description": "Build and check concurrency settings.",
            "default": {},
            "type": "object",
            "properties": {
                "cpu": {
                    "description": "CPU allocation passed to builders.",
                    "type": "string"
                },
                "parallel": {
                    "default": 2,
                    "description": "Concurrent package builds.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                },
                "updateCheckCocurrent": {
                    "default": 1,
                    "description": "Concurrent version checks.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                }
            },
            "additionalProperties": false
        },
        "repo": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Local pacman repository name."
                },
                "removeOld": {
                    "default": false,
                    "description": "Pass -R to repo-add so the previous package file and its signature are deleted when a different version of the same package name replaces it. After each repo-add, also repo-remove packages with the same pkgbase that the build no longer produced (dropped split packages, or -debug packages after debug was turned off) and delete their files. Files already missing from the database are not removed.",
                    "type": "boolean"
                },
                "removeOrphans": {
                    "default": false,
                    "description": "When a package recorded in data/versions.json is no longer in packages, run repo-remove for every database entry built from its pkgbase (split and -debug packages included; <pkgname> and <pkgname>-debug when no entry matches) and delete their package files and signatures before dropping the versions.json entry. Entries already dropped while this was off are not cleaned up. Packages never recorded in versions.json, such as ones added to the repository by hand, are never removed.",
                    "type": "boolean"
                }
            },
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "description": "Local pacman repository settings."
        },
        "webhooks": {
            "description": "Webhook notification endpoints.",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Webhook identifier for logging."
                    },
                    "url": {
                        "type": "string",
                        "description": "Webhook endpoint URL. Supports {{variable}} templates."
                    },
                    "method": {
                        "description": "HTTP method. Default: POST.",
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST"
                        ]
                    },
                    "headers": {
                        "description": "Custom HTTP headers.",
                        "type": "object",
                        "propertyNames": {
                            "type": "string"
                        },
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "payload": {
                        "description": "Request payload. Default: {message: <rendered template>}. Supports {{variable}} templates.",
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "object",
                                "propertyNames": {
                                    "type": "string"
                                },
                                "additionalProperties": {}
                            }
                        ]
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "SESSION_START",
                                "SESSION_END",
                                "SESSION_FAILED",
                                "APPROVAL_NEW_PACKAGE",
                                "APPROVAL_NEW_MAINTAINER",
                                "APPROVAL_UNAPPROVED",
                                "APPROVAL_PASSED",
                                "PACKAGE_UPDATED",
                                "PACKAGE_NO_UPDATE",
                                "PACKAGE_CHECK_FAILED",
                                "BUILD_START",
                                "BUILD_SUCCESSFUL",
                                "BUILD_FAILED",
                                "PUSH_START",
                                "PUSH_SUCCESSFUL",
                                "PUSH_FAILED"
                            ],
                            "description": "Webhook event tag."
                        },
                        "description": "Event tags this webhook subscribes to."
                    },
                    "templates": {
                        "description": "Custom message templates for each tag. Uses default templates if omitted.",
                        "type": "object",
                        "propertyNames": {
                            "type": "string",
                            "enum": [
                                "SESSION_START",
                                "SESSION_END",
                                "SESSION_FAILED",
                                "APPROVAL_NEW_PACKAGE",
                                "APPROVAL_NEW_MAINTAINER",
                                "APPROVAL_UNAPPROVED",
                                "APPROVAL_PASSED",
                                "PACKAGE_UPDATED",
                                "PACKAGE_NO_UPDATE",
                                "PACKAGE_CHECK_FAILED",
                                "BUILD_START",
                                "BUILD_SUCCESSFUL",
                                "BUILD_FAILED",
                                "PUSH_START",
                                "PUSH_SUCCESSFUL",
                                "PUSH_FAILED"
                            ],
                            "description": "Webhook event tag."
                        },
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "url",
                    "tags"
                ],
                "additionalProperties": false,
                "description": "A webhook notification endpoint."
            }
        },
        "packages": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "pkgname": {
                        "type": "string",
                        "description": "Local package name."
                    },
                    "maintainer": {
                        "description": "Maintainer id. Defaults to default_maintainer.",
                        "type": "string"
                    },
                    "allow_orphan_package_build": {
                        "description": "Allow building an orphan AUR package.",
                        "type": "boolean"
                    },
                    "aur_pkgname": {
                        "description": "AUR package name when it differs from pkgname.",
                        "type": "string"
                    },
                    "git": {
                        "description": "Package PKGBUILD git URL override.",
                        "type": "string"
                    },
                    "checker": {
                        "oneOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "strip_version": {
                                        "description": "Keep only the part of the version before the first - or _ (for example, drop a Debian or RPM release).",
                                        "type": "boolean"
                                    },
                                    "normalize": {
                                        "description": "Replace colons, slashes, hyphens and whitespace in the version with underscores. Only applies to the github checker.",
                                        "type": "boolean"
                                    },
                                    "template": {
                                        "description": "Template mapping upstream version text to PKGBUILD variables. Versions that do not match the template are ignored when picking the latest.",
                                        "type": "string"
                                    },
                                    "type": {
                                        "type": "string",
                                        "const": "github",
                                        "description": "Use GitHub release data."
                                    },
                                    "repo": {
                                        "type": "string",
                                        "description": "GitHub repository as owner/name."
                                    },
                                    "use": {
                                        "description": "Release selector such as release or prerelease.",
                                        "type": "string"
                                    },
                                    "prefix": {
                                        "description": "Required tag prefix. Releases whose tag lacks it are skipped; it is stripped from the matching tag.",
                                        "type": "string"
                                    },
                                    "suffix": {
                                        "description": "Required tag suffix. Releases whose tag lacks it are skipped; it is stripped from the matching tag.",
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "type",
                                    "repo"
                                ],
                                "additionalProperties": false,
                                "description": "GitHub version checker."
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "strip_version": {
                                        "description": "Keep only the part of the version before the first - or _ (for example, drop a Debian or RPM release).",
                                        "type": "boolean"
                                    },
                                    "normalize": {
                                        "description": "Replace colons, slashes, hyphens and whitespace in the version with underscores. Only applies to the github checker.",
                                        "type": "boolean"
                                    },
                                    "template": {
                                        "description": "Template mapping upstream version text to PKGBUILD variables. Versions that do not match the template are ignored when picking the latest.",
                                        "type": "string"
                                    },
                                    "type": {
                                        "type": "string",
                                        "const": "deb",
                                        "description": "Use a Debian Packages index."
                                    },
                                    "url": {
                                        "type": "string",
                                        "description": "Repository base URL."
                                    },
                                    "pkg": {
                                        "type": "string",
                                        "description": "Debian package name."
                                    },
                                    "dist": {
                                        "type": "string",
                                        "description": "Debian distribution name."
                                    },
                                    "component": {
                                        "type": "string",
                                        "description": "Debian repository component."
                                    },
                                    "arch": {
                                        "description": "Debian architecture.",
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "type",
                                    "url",
                                    "pkg",
                                    "dist",
                                    "component"
                                ],
                                "additionalProperties": false,
                                "description": "Debian repository version checker."
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "strip_version": {
                                        "description": "Keep only the part of the version before the first - or _ (for example, drop a Debian or RPM release).",
                                        "type": "boolean"
                                    },
                                    "normalize": {
                                        "description": "Replace colons, slashes, hyphens and whitespace in the version with underscores. Only applies to the github checker.",
                                        "type": "boolean"
                                    },
                                    "template": {
                                        "description": "Template mapping upstream version text to PKGBUILD variables. Versions that do not match the template are ignored when picking the latest.",
                                        "type": "string"
                                    },
                                    "type": {
                                        "type": "string",
                                        "const": "rpm",
                                        "description": "Use an RPM repository."
                                    },
                                    "url": {
                                        "type": "string",
                                        "description": "Repository base URL."
                                    },
                                    "pkg": {
                                        "type": "string",
                                        "description": "RPM package name."
                                    }
                                },
                                "required": [
                                    "type",
                                    "url",
                                    "pkg"
                                ],
                                "additionalProperties": false,
                                "description": "RPM repository version checker."
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "strip_version": {
                                        "description": "Keep only the part of the version before the first - or _ (for example, drop a Debian or RPM release).",
                                        "type": "boolean"
                                    },
                                    "normalize": {
                                        "description": "Replace colons, slashes, hyphens and whitespace in the version with underscores. Only applies to the github checker.",
                                        "type": "boolean"
                                    },
                                    "template": {
                                        "description": "Template mapping upstream version text to PKGBUILD variables. Versions that do not match the template are ignored when picking the latest.",
                                        "type": "string"
                                    },
                                    "type": {
                                        "type": "string",
                                        "const": "json",
                                        "description": "Use a JSON HTTP response."
                                    },
                                    "url": {
                                        "type": "string",
                                        "description": "URL returning JSON."
                                    },
                                    "params": {
                                        "description": "Query parameters appended to url. String values support {{timestamp}} (milliseconds) and {{random=N}} (N random [A-Za-z0-9] characters, 1-256), generated on every request.",
                                        "type": "object",
                                        "propertyNames": {
                                            "type": "string"
                                        },
                                        "additionalProperties": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "number"
                                                },
                                                {
                                                    "type": "boolean"
                                                }
                                            ]
                                        }
                                    },
                                    "path": {
                                        "type": "string",
                                        "description": "JSONPath expression selecting version strings or numbers, e.g. $[0].releases[?(@.type==\"release\")].version. Filter expressions use the safe evaluator."
                                    },
                                    "sort_by": {
                                        "description": "How to pick among matches: version takes the newest by version comparison; none takes the first match. Default: version.",
                                        "type": "string",
                                        "enum": [
                                            "version",
                                            "none"
                                        ]
                                    }
                                },
                                "required": [
                                    "type",
                                    "url",
                                    "path"
                                ],
                                "additionalProperties": false,
                                "description": "JSON HTTP response version checker."
                            }
                        ],
                        "description": "Upstream version checker."
                    },
                    "builder": {
                        "description": "Build command such as extra-x86_64-build.",
                        "type": "string"
                    },
                    "push": {
                        "description": "Push package PKGBUILD changes to AUR on success.",
                        "type": "boolean"
                    },
                    "checksumArch": {
                        "description": "Checksum scope for this package; overrides config.checksumArch. all runs updpkgsums for every architecture. target only downloads and hashes the generic and builder architecture sources and leaves other architectures' checksums outdated, so it requires a devtools builder such as extra-x86_64-build and is refused when push is true.",
                        "type": "string",
                        "enum": [
                            "all",
                            "target"
                        ]
                    },
                    "dummy_packages": {
                        "description": "Dummy packages installed before build.",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "dummy": {
                                    "type": "string",
                                    "description": "Dummy package name."
                                },
                                "epoch": {
                                    "description": "Dummy package epoch.",
                                    "anyOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "number"
                                        }
                                    ]
                                },
                                "pkgver": {
                                    "description": "Dummy package version.",
                                    "anyOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "number"
                                        }
                                    ]
                                },
                                "pkgrel": {
                                    "description": "Dummy package release.",
                                    "anyOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "number"
                                        }
                                    ]
                                },
                                "files": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Files provided by the dummy package."
                                }
                            },
                            "required": [
                                "dummy"
                            ],
                            "additionalProperties": false,
                            "description": "A generated dummy dependency package."
                        }
                    },
                    "repo_packages": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Local repo packages required before this build."
                    },
                    "pre-build-packages": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Packages installed in chroot before build."
                    },
                    "pre-build-scripts": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Root scripts run in chroot before build."
                    },
                    "pre_build_packages": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Alias for pre-build-packages."
                    },
                    "pre_build_scripts": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Alias for pre-build-scripts."
                    },
                    "toolchain": {
                        "description": "Per-package toolchain overrides. Set fields replace config.toolchain field by field.",
                        "type": "object",
                        "properties": {
                            "llvm": {
                                "description": "Build with Clang/LLVM: CC=clang, CXX=clang++, llvm-ar/llvm-ranlib/llvm-nm, and llvm-strip. Links with LLD in driver mode unless lld is false or mold is enabled. Installs clang and llvm in the chroot.",
                                "type": "boolean"
                            },
                            "mold": {
                                "description": "Link with mold. driver (or true): -fuse-ld=mold in LDFLAGS and RUSTFLAGS. replace: point /usr/bin/ld at ld.mold in the build chroot so every link uses mold. Installs mold in the chroot.",
                                "anyOf": [
                                    {
                                        "type": "boolean"
                                    },
                                    {
                                        "type": "string",
                                        "enum": [
                                            "driver",
                                            "replace"
                                        ]
                                    }
                                ]
                            },
                            "lld": {
